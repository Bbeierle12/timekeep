# Set this for local development when running the web dev server separately.
# In production, the frontend is served from the same origin as the API, so this is not needed.
VITE_API_URL=http://localhost:4000

# Supabase (for real-time subscriptions and direct storage access)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

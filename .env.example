# Server
PORT=4000
JWT_SECRET=replace_me
CSRF_SECRET=replace_me_too
RATE_LIMIT_REDIS_URL=

# Database — use ONE of the following:
# Option A: Supabase (recommended for production)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Option B: Local PostgreSQL (for offline development)
# DATABASE_URL=postgres://timekeep:timekeep@localhost:5432/timekeep

# Web
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
